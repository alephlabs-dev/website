---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
  /** Ink pages are dark; plaster pages are light. Drives body colour + hover + grain. */
  theme?: 'dark' | 'light';
}

const {
  title,
  description = 'Custom software, internal tools and AI integration for small businesses — eight years of production engineering, based in Buenos Aires, working worldwide.',
  theme = 'dark',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={theme} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Martian+Mono:wdth,wght@75..112.5,100..800&display=swap"
      rel="stylesheet"
    />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230A0C0F'/%3E%3Crect x='14.5' y='7' width='3.2' height='18' fill='%23EAEBE5' transform='rotate(24 16 16)'/%3E%3Crect x='9' y='9' width='2.6' height='8.5' fill='%232229DE' transform='rotate(-38 16 16)'/%3E%3Crect x='20.4' y='14.5' width='2.6' height='8.5' fill='%232229DE' transform='rotate(-38 16 16)'/%3E%3C/svg%3E"
    />

    <!-- Flip no-js off as early as possible so reveal states are owned by JS. -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body>
    <slot />

    {theme === 'dark' && <div class="grain"></div>}
    <Analytics />

    <script>
      import { startClock } from '../scripts/clock';
      import { initMenu } from '../scripts/menu';
      import { initMotion } from '../scripts/motion';
      import { initWorkIndex } from '../scripts/workIndex';

      startClock();
      initMenu();
      initWorkIndex();
      initMotion();
    </script>
  </body>
</html>
