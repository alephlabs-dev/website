---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const CAL = 'https://cal.com/alephlabs';

const buildItems = [
  { label: 'Clients & providers', body: 'Every client, quote and conversation in one place, with the full history attached. Providers, lead times and purchase orders alongside them.' },
  { label: 'Budgets & orders', body: "Quotes built from your real catalogue in minutes, with price snapshots frozen at the moment of sale. Last year's numbers stay last year's numbers." },
  { label: 'Production & inventory', body: "A pipeline that shows what's in progress, what's blocked and what's due — and stock levels that move when orders do." },
  { label: 'Portals', body: 'Your clients check their own order status. Your providers submit their own prices. Both stop arriving in your inbox.' },
  { label: 'Reporting & documents', body: 'The reports you currently rebuild by hand, generated. Branded PDFs — quotes, invoices, work orders — produced from live data.' },
  { label: 'Integrations', body: 'Accounting, payments, e-commerce, shipping, WhatsApp. The tools you already pay for keep working, wired into the same system.' },
];

const connectItems = [
  { label: 'MCP servers', body: 'Ask Claude or ChatGPT about your own data in plain language and have it act — read budgets, fix a missed sale, check stock. Scoped permissions, confirmations on anything destructive, a full audit trail.' },
  { label: 'Automation', body: 'The repetitive path between your tools, handled: quote accepted → order opened → provider notified → client emailed. Built as workflows you can read and change, not a black box.' },
  { label: 'Reporting & forecasting', body: 'Monthly summaries written from your actual numbers, demand and cash-flow forecasts built on your own history. Useful because the data underneath it is clean.' },
];

const engagements = [
  { bar: 'var(--on-plaster)', title: 'Discovery sprint', meta: '1–2 weeks · fixed fee', body: 'We map how your business really works and hand back a scope, an architecture and a number. Yours to keep, whoever builds it.' },
  { bar: 'var(--ultramarine)', title: 'Scoped build', meta: '6–10 weeks · fixed scope', body: 'The system, built in stages, in your hands early. Deployed, documented, and supported for 30 days after launch as standard.' },
  { bar: 'var(--citron)', title: 'Ongoing partner', meta: 'Monthly · capped hours', body: 'For businesses whose software keeps growing. New modules, AI integrations, maintenance and someone who already knows your codebase.' },
];
---

<Base title="Services — Aleph Labs" theme="light">
  <Header active="services" theme="light" />

  <!-- ── Services index ─────────────────────────────────────── -->
  <section class="index">
    <div class="wrap index-wrap">
      <div class="index-copy">
        <div class="eyebrow muted">Services / two lines of work</div>
        <h1 class="index-h1 reveal-lines">
          <span class="line-mask"><span class="line-inner">We build the system,</span></span>
          <span class="line-mask"><span class="line-inner">then we connect it.</span></span>
        </h1>
        <p class="index-lead" data-reveal>Most of our clients run on spreadsheets, WhatsApp and memory. First we replace that with software shaped around their business. Then, where it earns its place, we let AI act on it directly.</p>
      </div>
      <div class="index-links">
        <a href="#build" class="index-link">
          <span class="il-num">01</span>
          <span class="il-word">BUILD</span>
          <span class="il-sub">Custom software<br />&amp; internal tools</span>
        </a>
        <a href="#connect" class="index-link last">
          <span class="il-num">02</span>
          <span class="il-word">CONNECT</span>
          <span class="il-sub">AI integration<br />&amp; automation</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Build ──────────────────────────────────────────────── -->
  <section id="build" class="build">
    <div class="wrap section-col">
      <div class="lead-row">
        <div class="big-index">
          <div class="idx-num idx-num--blue">01</div>
          <h2 class="idx-title">Build</h2>
        </div>
        <div class="lead-text">
          <p class="lead-p">A business that has outgrown its spreadsheets doesn't need a bigger spreadsheet. It needs one system that knows its clients, its prices, its stock and its history — and behaves the way the business already does.</p>
          <p class="lead-note">Below is a sample of what a system might include — not a menu, and not a boundary. Yours gets shaped in discovery.</p>
        </div>
      </div>

      <div class="feature-grid">
        {
          buildItems.map((it) => (
            <div class="feature" data-reveal>
              <div class="eyebrow feat-label">{it.label}</div>
              <p class="feat-body">{it.body}</p>
            </div>
          ))
        }
      </div>

      <div class="facts">
        <div class="fact"><div class="fact-k">Typical first release</div><div class="fact-v">6–10 weeks</div></div>
        <div class="fact"><div class="fact-k">You own</div><div class="fact-v">Code, data, docs</div></div>
        <div class="fact"><div class="fact-k">You talk to</div><div class="fact-v">The engineer</div></div>
      </div>
    </div>
  </section>

  <!-- ── Connect ────────────────────────────────────────────── -->
  <section id="connect" class="connect">
    <div class="wrap section-col">
      <div class="lead-row">
        <div class="big-index">
          <div class="idx-num idx-num--dim">02</div>
          <h2 class="idx-title">Connect</h2>
        </div>
        <p class="lead-p connect-lead">Chat that can only talk is a demo. We give the model real, permissioned access to your systems, so asking becomes doing — and every action it takes is logged.</p>
      </div>

      <div class="connect-cols">
        <div class="terminal-lg" data-reveal>
          <div class="term-label">MCP server · alephlabs/estudio · session 0412</div>
          <div><span class="prompt">›</span> give me the last five budgets</div>
          <div class="term-out">→ budgets.list(limit: 5, sort: −date)</div>
          <div class="term-out">→ 5 rows · ARS 18.4M · Mar–Jul 2026</div>
          <div class="term-gap"></div>
          <div><span class="prompt">›</span> I forgot to log friday's sale — 2 Vera chairs, oak, to Marina</div>
          <div class="term-out">→ clients.match("Marina") → #0231</div>
          <div class="term-out">→ orders.create(items: 2 × VERA-OAK, price_snapshot: 2026-07-24)</div>
          <div class="term-out">→ inventory.adjust(oak_panel: −6)</div>
          <div class="term-ok">✓ order #1182 created · awaiting your confirmation</div>
        </div>
        <div class="connect-notes">
          {
            connectItems.map((it) => (
              <div class="cnote" data-reveal>
                <div class="eyebrow cnote-label">{it.label}</div>
                <p class="cnote-body">{it.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ── Engagements ────────────────────────────────────────── -->
  <section class="engagements">
    <div class="wrap section-col">
      <div class="sec-head">
        <div class="eyebrow muted">03 / Engagements</div>
        <h2 class="sec-title">Three ways to start</h2>
      </div>
      <div class="eng-grid">
        {
          engagements.map((e) => (
            <div class="eng" data-reveal>
              <div class="eng-bar" style={`background:${e.bar}`} />
              <div class="eng-title">{e.title}</div>
              <div class="eyebrow eng-meta">{e.meta}</div>
              <p class="eng-body">{e.body}</p>
            </div>
          ))
        }
      </div>
      <div class="tooling">
        <div class="eyebrow muted tooling-k">On tooling</div>
        <p class="tooling-p">We don't sell a toolbox. Tools get chosen per project, for reasons we'll explain in plain language — chosen so your software is fast to change in two years, not so it matches whatever is fashionable this one.</p>
      </div>
    </div>
  </section>

  <!-- ── CTA ────────────────────────────────────────────────── -->
  <section class="cta-section">
    <div class="wrap cta-wrap">
      <h2 class="cta-h2 reveal-lines">
        <span class="line-mask"><span class="line-inner">Not sure which one you need?</span></span>
        <span class="line-mask"><span class="line-inner">That's what the call is for.</span></span>
      </h2>
      <div class="cta-actions" data-reveal>
        <p class="cta-copy">Thirty minutes, no deck. Describe the mess and we'll tell you plainly whether software fixes it — and roughly what it would take.</p>
        <a href={CAL} class="cta cta--citron cta-book">[ Book a call ]</a>
        <a href="mailto:nacho@alephlabs.dev" class="cta-email">nacho@alephlabs.dev</a>
      </div>
    </div>
  </section>

  <Footer
    links={[
      { href: '/', label: 'Home' },
      { href: '/work', label: 'Work' },
      { href: '/about', label: 'About' },
    ]}
    padTop={20}
  />
</Base>

<style>
  .wrap {
    max-width: 1700px;
  }
  .muted {
    color: #6b7178;
  }
  .section-col {
    display: flex;
    flex-direction: column;
    gap: clamp(44px, 5vw, 84px);
  }
  .sec-head {
    display: flex;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
  }
  .sec-title {
    margin: 0;
    font-size: clamp(26px, 3vw, 46px);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variation-settings: 'wght' 750, 'wdth' 105;
  }

  /* ---- Index ---- */
  .index {
    padding: clamp(48px, 6vw, 100px) clamp(18px, 3vw, 32px) clamp(40px, 5vw, 72px);
  }
  .index-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 4vw, 72px);
    align-items: end;
  }
  .index-copy {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .index-h1 {
    margin: 0;
    font-size: clamp(34px, 5.6vw, 96px);
    line-height: 0.88;
    letter-spacing: -0.04em;
    font-variation-settings: 'wght' 820, 'wdth' 114;
  }
  .index-lead {
    margin: 0;
    font-size: clamp(17px, 1.3vw, 21px);
    line-height: 1.45;
    color: var(--body-plaster);
    max-width: 52ch;
  }
  .index-links {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .index-link {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    align-items: center;
    padding: 26px 0;
    border-top: 1px solid var(--rule-plaster);
  }
  .index-link.last {
    border-bottom: 1px solid var(--rule-plaster);
  }
  .index-link:hover {
    color: var(--ultramarine);
  }
  .il-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: #6b7178;
  }
  .il-word {
    flex: 1 1 150px;
    font-size: clamp(30px, 4.4vw, 68px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variation-settings: 'wght' 800, 'wdth' 116;
  }
  .il-sub {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #6b7178;
    text-align: right;
    margin-left: auto;
  }

  /* ---- Build (ink) ---- */
  .build {
    background: var(--ink);
    color: var(--on-ink);
    padding: clamp(72px, 9vw, 140px) clamp(18px, 3vw, 32px);
  }
  .lead-row {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 4vw, 72px);
    align-items: end;
  }
  .big-index {
    flex: 1 1 280px;
    display: flex;
    align-items: flex-end;
    gap: 24px;
  }
  .idx-num {
    font-size: clamp(48px, 11vw, 190px);
    line-height: 0.74;
    letter-spacing: -0.055em;
    font-variation-settings: 'wght' 840, 'wdth' 120;
  }
  .idx-num--blue {
    color: var(--ultramarine);
  }
  .idx-num--dim {
    color: rgba(245, 245, 240, 0.45);
  }
  .idx-title {
    margin: 0;
    font-size: clamp(38px, 5.4vw, 96px);
    line-height: 0.82;
    letter-spacing: -0.045em;
    font-variation-settings: 'wght' 820, 'wdth' 116;
  }
  .lead-text {
    flex: 1 1 380px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 52ch;
  }
  .lead-p {
    margin: 0;
    font-size: clamp(17px, 1.3vw, 21px);
    line-height: 1.45;
    color: var(--body-ink);
  }
  .lead-note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
    color: var(--steel);
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: clamp(32px, 3.5vw, 60px);
  }
  .feature {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .feat-label {
    color: var(--citron);
    font-size: 11px;
    letter-spacing: 0.05em;
  }
  .feat-body {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--dim-ink);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(28px, 3vw, 56px);
    background: var(--graphite);
    padding: clamp(28px, 3vw, 48px);
  }
  .fact {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .fact-k {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--slate);
  }
  .fact-v {
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variation-settings: 'wght' 780, 'wdth' 108;
  }

  /* ---- Connect (ultramarine) ---- */
  .connect {
    background: var(--ultramarine);
    color: var(--on-ultramarine);
    padding: clamp(72px, 9vw, 140px) clamp(18px, 3vw, 32px);
  }
  .connect-lead {
    flex: 1 1 380px;
    max-width: 50ch;
    color: var(--on-ultramarine);
  }
  .connect-cols {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 4vw, 72px);
    align-items: start;
  }
  .terminal-lg {
    flex: 1 1 420px;
    min-width: 0;
    background: var(--ink);
    padding: clamp(22px, 2.4vw, 34px);
    font-family: var(--font-mono);
    font-size: clamp(12px, 1.05vw, 14px);
    line-height: 2.1;
    color: var(--body-ink);
  }
  .term-label {
    color: var(--slate);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .prompt {
    color: var(--citron);
  }
  .term-out {
    color: var(--steel);
  }
  .term-ok {
    color: var(--citron);
  }
  .term-gap {
    height: 14px;
  }
  .connect-notes {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(26px, 3vw, 40px);
  }
  .cnote {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cnote-label {
    opacity: 0.72;
    font-size: 11px;
    letter-spacing: 0.05em;
  }
  .cnote-body {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
  }

  /* ---- Engagements (plaster) ---- */
  .engagements {
    background: var(--plaster);
    color: var(--on-plaster);
    padding: clamp(72px, 9vw, 130px) clamp(18px, 3vw, 32px);
  }
  .eng-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(32px, 4vw, 64px);
  }
  .eng {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .eng-bar {
    height: 3px;
  }
  .eng-title {
    font-size: clamp(22px, 2.2vw, 32px);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variation-settings: 'wght' 790, 'wdth' 108;
  }
  .eng-meta {
    color: #6b7178;
    font-size: 11px;
    letter-spacing: 0.05em;
  }
  .eng-body {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--body-plaster);
  }
  .tooling {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 3vw, 56px);
    padding-top: clamp(20px, 2vw, 32px);
    align-items: start;
  }
  .tooling-k {
    padding-top: 8px;
    flex: 0 1 150px;
  }
  .tooling-p {
    flex: 1 1 420px;
    margin: 0;
    font-size: clamp(17px, 1.3vw, 21px);
    line-height: 1.45;
    color: var(--body-plaster);
    max-width: 62ch;
  }

  /* ---- CTA (ink) ---- */
  .cta-section {
    background: var(--ink);
    color: var(--on-ink);
    padding: clamp(76px, 9vw, 150px) clamp(18px, 3vw, 32px);
  }
  .cta-wrap {
    max-width: 1560px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(32px, 4vw, 72px);
    align-items: end;
  }
  .cta-h2 {
    margin: 0;
    font-size: clamp(30px, 5vw, 84px);
    line-height: 0.88;
    letter-spacing: -0.04em;
    font-variation-settings: 'wght' 820, 'wdth' 114;
    max-width: 20ch;
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }
  .cta-copy {
    margin: 0;
    font-size: 17.5px;
    line-height: 1.5;
    color: var(--dim-ink);
    max-width: 44ch;
  }
  .cta-book {
    color: var(--ink);
  }
  .cta--citron:hover {
    background: var(--on-ink);
    color: var(--ink);
  }
  .cta-email {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.03em;
    color: var(--steel);
    border-bottom: 1px solid #35393e;
    padding-bottom: 3px;
  }
</style>
